# ---------------------------------------------------------------------------
# Modèle de configuration. Copier ce fichier en `.env` puis renseigner les
# valeurs. Le fichier `.env` est ignoré par Git : aucun secret ne doit être
# committé.
#
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
# ---------------------------------------------------------------------------

# Environnement d'exécution : local | recette | production
APP_ENV=local

# Niveau de log : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Journalisation des requêtes SQL émises par SQLAlchemy (true en debug seulement)
SQL_ECHO=false


# --------------------------------- PostgreSQL ------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=changeme
PG_PASSWORD=changeme
PG_DB_NAME=changeme
# Schéma par défaut appliqué au search_path (laisser vide pour "public")
PG_SCHEMA=
# disable | allow | prefer | require | verify-ca | verify-full
PG_SSLMODE=prefer


# ----------------------------------- Oracle --------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=changeme
ORACLE_PASSWORD=changeme
# Renseigner SOIT le service name (recommandé), SOIT le SID.
ORACLE_SERVICE_NAME=changeme
ORACLE_SID=
# thin (aucun client à installer) | thick (nécessite Oracle Instant Client)
ORACLE_CLIENT_MODE=thin
# Requis uniquement en mode thick
ORACLE_CLIENT_LIB_DIR=


# ------------------------------ Pool de connexions -------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Secondes d'attente avant échec d'obtention d'une connexion du pool
DB_POOL_TIMEOUT=30
# Recyclage des connexions (secondes) — évite les coupures firewall/idle
DB_POOL_RECYCLE=1800
# Timeout d'établissement de connexion (secondes)
DB_CONNECT_TIMEOUT=10
